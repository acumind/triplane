# Copy to .env.local (same directory) and fill in. Next loads .env.local from the
# directory it runs in — apps/web — so a root .env will NOT be picked up here.
# Never commit .env.local; .gitignore already covers it.

# Powers the sidebar agent. Read only by app/api/agent/route.ts, server-side: the
# proxy exists so the key never reaches the browser. Without it the sidebar answers
# "ANTHROPIC_API_KEY not set on the server." and the rest of the site works fine.
ANTHROPIC_API_KEY=

# WebMCP origin trial (Chrome 149-156), registered per origin, so each deployment
# needs its own. Without it the sidebar falls back to calling the same tool contract
# directly — identical behaviour, minus the real document.modelContext registration.
NEXT_PUBLIC_WEBMCP_OT_TOKEN=
