# Build-time and CLI variables, read by triplane.config.ts.
#
# These are NOT auto-loaded: tsx does not read .env files, and Next only loads env
# files under apps/web. Export them in your shell, prefix the command, or set them
# on the Vercel project:
#
#   export TRIPLANE_DOMAIN=http://localhost:3000
#   TRIPLANE_BUNDLE=triplane-docs npm run build:docs
#
# The web app's own variables live in apps/web/.env.example.

# Which bundle this deployment publishes: meridian (default) | triplane-docs.
# Selects the bundle AND the brand and publisher identity together — set it, or the
# catalog will publish under the wrong publisher (build.ts warns when they disagree).
TRIPLANE_BUNDLE=

# The origin the ARD catalog and llms.txt advertise. Accepts a bare host
# (docs.example.com) or a full origin (http://localhost:3000) for local ARD runs.
# Unset falls back to a placeholder domain, and ard-agent.ts then has to rewrite the
# endpoint back to the origin it discovered from.
TRIPLANE_DOMAIN=

# Governance backend. With BOTH set, the write plane switches from the local fs store
# to the GitHub store: a proposal becomes a PR and approval becomes a merge. With
# either missing, proposals stay in <bundle>/.proposals/ on disk.
GITHUB_TOKEN=
TRIPLANE_REPO=
