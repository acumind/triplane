{
  "name": "triplane",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins/*"
  ],
  "scripts": {
    "build:bundle": "tsx packages/cli/src/build.ts bundles/${TRIPLANE_BUNDLE:-meridian}",
    "build:meridian": "tsx packages/cli/src/build.ts bundles/meridian",
    "build:docs": "TRIPLANE_BUNDLE=triplane-docs tsx packages/cli/src/build.ts bundles/triplane-docs",
    "build:controls": "TRIPLANE_BUNDLE=controls tsx packages/cli/src/build.ts bundles/controls",
    "build:dhruva": "TRIPLANE_BUNDLE=dhruva tsx packages/cli/src/build.ts bundles/dhruva",
    "typecheck": "tsc -p packages/engine && tsc -p packages/cli && tsc -p plugins/triplane-ard",
    "greptest": "bash scripts/greptest.sh",
    "web": "TRIPLANE_DOMAIN=http://localhost:3000 npm run build:meridian && npm run dev --workspace apps/web",
    "instance:docs": "bash scripts/second-instance.sh",
    "ard": "tsx plugins/triplane-ard/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
